<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSurvey.MainPage"
             x:Name="_QuestionnairePage_"
             Title="Путешествие мечты" BackgroundColor="#F3F6F0">
    <ScrollView x:Name="_FormScroll_">
        <VerticalStackLayout x:Name="_PageLayout_" Padding="20,24" Spacing="18"
                             MaximumWidthRequest="720" HorizontalOptions="Fill">
            <Border x:Name="_HeroCard_" BackgroundColor="#DDECE4" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout x:Name="_HeroLayout_" Spacing="8">
                    <Label x:Name="_EyebrowLabel_" Text="АНКЕТА ПУТЕШЕСТВЕННИКА"
                           FontSize="12" FontAttributes="Bold" CharacterSpacing="2" />
                    <Label x:Name="_TitleLabel_" Text="Путешествие мечты"
                           FontSize="30" FontAttributes="Bold" Margin="0,4,0,0" />
                    <Label x:Name="_IntroLabel_" Text="Какой отпуск подходит именно вам? Расскажите о своих планах и получите сводку ответов."
                           FontSize="15" FontAttributes="None" />
                    <Image x:Name="_TravelImage_" Source="journey.png" Aspect="AspectFit"
                           HeightRequest="150" Margin="0,8,0,0"
                           SemanticProperties.Description="Горы, солнце и дорога к путешествию" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="_BasicsCard_" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout x:Name="_BasicsLayout_" Spacing="12">
                    <Label x:Name="_BasicsTitle_" Text="01 / Немного о вас" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="_RequiredHint_" Text="* Обязательные поля" FontSize="13" FontAttributes="None" />
                    <Label x:Name="_NameLabel_" Text="Как вас зовут? *" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="_NameEntry_" Placeholder="Например, Алексей" Keyboard="Default"
                           MaxLength="60" Text="" TextChanged="OnEntryTextChanged" Margin="0,0,0,4" />
                    <Label x:Name="_BudgetLabel_" Text="Бюджет на поездку, ₽ *" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="_BudgetEntry_" Placeholder="Например, 50000" Keyboard="Numeric"
                           MaxLength="8" Text="" TextChanged="OnEntryTextChanged" Margin="0,0,0,4" />
                    <Label x:Name="_ReadyLabel_" Text="Обязательные поля заполнены. Можно показать результат."
                           FontSize="13" FontAttributes="None" TextColor="#176B63" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="_PlansCard_" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout x:Name="_PlansLayout_" Spacing="12">
                    <Label x:Name="_PlansTitle_" Text="02 / Ваш маршрут" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="_DestinationLabel_" Text="Куда хочется поехать?" FontSize="15" FontAttributes="Bold" />
                    <Picker x:Name="_DestinationPicker_" Title="Выберите направление" SelectedIndex="-1"
                            SelectedIndexChanged="OnSelectionChanged" Margin="0,0,0,4">
                        <Picker.Items>
                            <x:String>Горы</x:String>
                            <x:String>Море</x:String>
                            <x:String>Большой город</x:String>
                            <x:String>Лес и озёра</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label x:Name="_PaceLabel_" Text="Какой темп отдыха вам ближе?" FontSize="15" FontAttributes="Bold" />
                    <VerticalStackLayout x:Name="_PaceLayout_" Spacing="0">
                        <RadioButton x:Name="_QuietRadio_" Content="Спокойный отдых" GroupName="TravelPace"
                                     Value="Спокойный отдых" IsChecked="False" CheckedChanged="OnRadioCheckedChanged" />
                        <RadioButton x:Name="_BalancedRadio_" Content="Всего понемногу" GroupName="TravelPace"
                                     Value="Всего понемногу" IsChecked="True" CheckedChanged="OnRadioCheckedChanged" />
                        <RadioButton x:Name="_ActiveRadio_" Content="Больше приключений" GroupName="TravelPace"
                                     Value="Больше приключений" IsChecked="False" CheckedChanged="OnRadioCheckedChanged" />
                    </VerticalStackLayout>
                    <Label x:Name="_DateLabel_" Text="Когда отправимся?" FontSize="15" FontAttributes="Bold" />
                    <DatePicker x:Name="_DepartureDate_" Format="dd.MM.yyyy"
                                MinimumDate="01/01/2026" MaximumDate="12/31/2035" Date="10/09/2026"
                                DateSelected="OnDateSelected" Margin="0,0,0,4" />
                    <Label x:Name="_DurationTitle_" Text="Продолжительность поездки" FontSize="15" FontAttributes="Bold" />
                    <Grid x:Name="_DurationGrid_" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                          RowSpacing="8" ColumnSpacing="12" Padding="0,4">
                        <Label x:Name="_DurationHint_" Grid.Row="0" Grid.Column="0"
                               Text="От 1 до 30 дней" FontSize="14" FontAttributes="None" />
                        <Label x:Name="_DurationValue_" Grid.Row="0" Grid.Column="1"
                               Text="{Binding Source={x:Reference _DurationStepper_}, Path=Value, Mode=OneWay, StringFormat='{0:0} дн.'}"
                               FontSize="18" FontAttributes="Bold" TextColor="#176B63" />
                        <Stepper x:Name="_DurationStepper_" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Minimum="1" Maximum="30" Value="7" Increment="1"
                                 ValueChanged="OnNumberChanged" HorizontalOptions="Start" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border x:Name="_ExtrasCard_" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout x:Name="_ExtrasLayout_" Spacing="12">
                    <Label x:Name="_ExtrasTitle_" Text="03 / Детали поездки" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="_InterestsLabel_" Text="Что добавим в программу?" FontSize="15" FontAttributes="Bold" />
                    <Grid x:Name="_InterestsGrid_" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*"
                          RowSpacing="4" ColumnSpacing="8" Padding="0,4">
                        <CheckBox x:Name="_ExcursionsCheck_" Grid.Row="0" Grid.Column="0" IsChecked="False"
                                  Color="#176B63" CheckedChanged="OnCheckChanged"
                                  SemanticProperties.Description="Экскурсии и музеи" />
                        <Label x:Name="_ExcursionsLabel_" Grid.Row="0" Grid.Column="1"
                               Text="Экскурсии и музеи" FontSize="15" FontAttributes="None" VerticalOptions="Center" />
                        <CheckBox x:Name="_FoodCheck_" Grid.Row="1" Grid.Column="0" IsChecked="False"
                                  Color="#176B63" CheckedChanged="OnCheckChanged"
                                  SemanticProperties.Description="Местная кухня" />
                        <Label x:Name="_FoodLabel_" Grid.Row="1" Grid.Column="1"
                               Text="Местная кухня" FontSize="15" FontAttributes="None" VerticalOptions="Center" />
                    </Grid>
                    <Grid x:Name="_GuideGrid_" RowDefinitions="Auto" ColumnDefinitions="*,Auto"
                          ColumnSpacing="12" Padding="0,4">
                        <Label x:Name="_GuideLabel_" Grid.Row="0" Grid.Column="0"
                               Text="Нужен гид" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch x:Name="_GuideSwitch_" Grid.Row="0" Grid.Column="1"
                                IsToggled="False" OnColor="#176B63" Toggled="OnGuideToggled"
                                SemanticProperties.Description="Нужен гид" />
                    </Grid>
                    <Label x:Name="_GuideHint_" Text="В сводке отметим, что вам нужна помощь гида."
                           FontSize="13" FontAttributes="None"
                           IsVisible="{Binding Source={x:Reference _GuideSwitch_}, Path=IsToggled, Mode=OneWay}" />
                    <Label x:Name="_WishesLabel_" Text="Ваши пожелания" FontSize="15" FontAttributes="Bold" />
                    <Editor x:Name="_WishesEditor_" Placeholder="Особые места, жильё или идеи для поездки…"
                            AutoSize="TextChanges" MaxLength="500" Text="" MinimumHeightRequest="110"
                            TextChanged="OnEditorTextChanged" Margin="0,0,0,4" />
                </VerticalStackLayout>
            </Border>
            <Label x:Name="_ValidationLabel_" Text="" FontSize="14" FontAttributes="Bold"
                   TextColor="#B43B32" IsVisible="False" Margin="4,0" />
            <VerticalStackLayout x:Name="_ActionsLayout_" Spacing="10">
                <Button x:Name="_ShowResultButton_" Text="Показать результат" Clicked="OnShowResultClicked"
                        BackgroundColor="#176B63" TextColor="White" FontAttributes="Bold" />
                <Button x:Name="_ClearButton_" Text="Очистить" Clicked="OnClearClicked"
                        BackgroundColor="#E1EAE4" TextColor="#203D3A" />
            </VerticalStackLayout>
            <Border x:Name="_ResultCard_" BackgroundColor="#DDECE4" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20" IsVisible="False" Margin="0,0,0,12">
                <VerticalStackLayout x:Name="_ResultLayout_" Spacing="12">
                    <Label x:Name="_ResultTitle_" Text="Ваша поездка" FontSize="22" FontAttributes="Bold" />
                    <Label x:Name="_ResultLabel_" Text="" FontSize="16" FontAttributes="None" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
