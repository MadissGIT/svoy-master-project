<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SvoyMaster.MasterCabinetPage" Title="Кабинет мастера">
  <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="*" RowSpacing="10">
    <Label x:Name="NameLabel" Grid.Row="0" Grid.Column="0" FontSize="24" FontAttributes="Bold" />
    <Label x:Name="ServiceLabel" Grid.Row="1" Grid.Column="0" />
    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="10">
      <Switch x:Name="AvailableSwitch" OnColor="#2563EB" Toggled="OnAvailableToggled" />
      <Label Text="Принимаю новые заявки" VerticalOptions="Center" />
    </HorizontalStackLayout>
    <Label x:Name="VerifyLabel" Grid.Row="3" Grid.Column="0" />
    <Button x:Name="VerifyButton" Grid.Row="4" Grid.Column="0" Text="Демопроверка через Госуслуги" Clicked="OnVerifyClicked" />
    <Label Grid.Row="5" Grid.Column="0" Text="Входящие заявки" FontSize="21" FontAttributes="Bold" Margin="0,8,0,0" />
    <CollectionView x:Name="OrdersList" Grid.Row="6" Grid.Column="0" SelectionMode="Single" SelectionChanged="OnOrderSelected">
      <CollectionView.EmptyView><Label Text="Входящих заявок пока нет. Создайте заявку Алексею в роли клиента." Padding="8" /></CollectionView.EmptyView>
      <CollectionView.ItemTemplate><DataTemplate x:DataType="{x:Null}">
        <VerticalStackLayout Padding="8,16" Spacing="8">
          <Label Text="{Binding Summary}" FontSize="18" />
          <Label Text="{Binding Customer, StringFormat='Клиент: {0}'}" />
          <BoxView HeightRequest="1" Color="#CBD5E1" />
        </VerticalStackLayout>
      </DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
