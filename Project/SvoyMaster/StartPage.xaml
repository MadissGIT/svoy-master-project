<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SvoyMaster.StartPage" Title="СвойМастер">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="600" HorizontalOptions="Fill">
      <Label Text="СвойМастер" FontSize="32" FontAttributes="Bold" Margin="0,30,0,0" />
      <Label Text="Найдите мастера для дел по дому" FontSize="20" />
      <Label Text="Учебная версия. Мастера вымышлены. Проверка через Госуслуги и оплата показаны как демонстрация, деньги не списываются." FontSize="14" />
      <Label x:Name="LoadLabel" FontSize="14" TextColor="#B3261E" />
      <Button Text="Я клиент" Clicked="OnClientClicked" />
      <Button Text="Я мастер" Clicked="OnMasterClicked" />
      <Label Text="Кабинет мастера открывается для Алексея из раздела «Сантехника». Можно создать ему заявку и проверить обе роли на одном устройстве." FontSize="14" />
      <Button Text="Сбросить демоданные" Clicked="OnResetClicked" BackgroundColor="#E2E8F0" TextColor="#1E293B" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
